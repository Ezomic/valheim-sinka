# Build output
bin/
obj/

# Local IDE / user files
*.user
*.suo
.vs/
.idea/

# BepInEx test profile: third-party binaries, not ours to redistribute.
# Recreate by copying the BepInEx tree from any existing profile.
testprofile/

# Thunderstore packaging: staging folder and the zips tcli writes.
package/
build/

# Thunderstore packages, rebuilt by own-profile/package.ps1 from the source in this repo.
# A zip in git is a build output, not a source, and it goes stale the moment anything under
# src or assets changes.
dist/
